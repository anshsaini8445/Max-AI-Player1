<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:controller_layout_id="@layout/custom_playback_controls"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="true" />

    <!-- GESTURE VOLUME HUD -->
    <androidx.cardview.widget.CardView
        android:id="@+id/hudVolume"
        android:layout_width="140dp"
        android:layout_height="120dp"
        android:layout_centerInParent="true"
        android:visibility="gone"
        app:cardBackgroundColor="#CC10121E"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgHudVolume"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvHudVolume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Volume: 80%"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- GESTURE BRIGHTNESS HUD -->
    <androidx.cardview.widget.CardView
        android:id="@+id/hudBrightness"
        android:layout_width="140dp"
        android:layout_height="120dp"
        android:layout_centerInParent="true"
        android:visibility="gone"
        app:cardBackgroundColor="#CC10121E"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/btn_star_big_on"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvHudBrightness"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Brightness: 65%"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- GESTURE SEEK HUD (Nano/Seconds Live Counter) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/hudSeek"
        android:layout_width="220dp"
        android:layout_height="90dp"
        android:layout_centerInParent="true"
        android:visibility="gone"
        app:cardBackgroundColor="#CC10121E"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvHudSeekDiff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+00:15s"
                android:textColor="#00E5FF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHudSeekTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="01:25 / 03:45"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>
